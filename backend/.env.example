POSTGRES_DB=garage_control
POSTGRES_USER=garage
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

# Generate with: openssl rand -base64 32
JWT_SECRET_BASE64=CHANGE_ME_GENERATE_A_32_BYTE_SECRET
JWT_ISSUER=garage-control-backend
JWT_ACCESS_TOKEN_TTL=PT30M

# Bootstrap is optional. Never commit the real password.
APP_INITIAL_ADMIN_ENABLED=false
APP_INITIAL_ADMIN_USERNAME=admin
APP_INITIAL_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS
APP_INITIAL_ADMIN_FULL_NAME=Administrador
APP_INITIAL_ADMIN_ROLE=SUPER_ADMIN

# Optional webhook secret. Leave empty when the camera cannot send a custom header.
HIKVISION_WEBHOOK_TOKEN=
HIKVISION_COOLDOWN=PT30S
HIKVISION_ENFORCE_REMOTE_IP=true
PARKING_ACCESS_MIN_CONFIDENCE=80

# Hikvision camera access (same login/password on both cameras)
HIKVISION_ENTRY_HOST=192.168.15.43
HIKVISION_EXIT_HOST=192.168.15.44
HIKVISION_PORT=80
HIKVISION_USERNAME=
HIKVISION_PASSWORD=
HIKVISION_IMAGE_STORAGE_PATH=./data/hikvision

# Gate control (Phase 11 - hardware adapter ready)
GATE_ENABLED=false
GATE_DRIVER=SIMULATED
GATE_ENTRY_URL=
GATE_EXIT_URL=
GATE_USERNAME=
GATE_PASSWORD=
GATE_BEARER_TOKEN=
GATE_TIMEOUT=PT3S
GATE_MAX_ATTEMPTS=3
GATE_RETRY_DELAY=PT5S
GATE_OPERATION_POLL_DELAY_MS=2000
GATE_INCLUDE_PLATE=false
GATE_OPEN_PULSE_MILLIS=1000

# Leave SIMULATED until the real gate/relay controller protocol is known.


# Security hardening
CORS_ALLOWED_ORIGINS=http://localhost:5173
SECURITY_TRUST_FORWARDED_HEADERS=false
SECURITY_HSTS_ENABLED=false
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_LOGIN_REQUESTS_PER_MINUTE=10
SECURITY_HIKVISION_REQUESTS_PER_MINUTE=120
SECURITY_RATE_LIMIT_FAIL_OPEN=false
SERVER_FORWARD_HEADERS_STRATEGY=none
SERVER_MAX_HTTP_REQUEST_HEADER_SIZE=16KB

# Dashboard
DASHBOARD_ZONE_ID=America/Recife
DASHBOARD_CACHE_TTL=PT5S

# Observability
APP_ENVIRONMENT=local
APP_VERSION=0.0.7-SNAPSHOT
LOG_STRUCTURED_FORMAT=ecs
MANAGEMENT_PORT=8081
MANAGEMENT_ADDRESS=0.0.0.0
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS

# Distinct per-camera webhook credentials (minimum 32 characters each).
HIKVISION_ENTRY_WEBHOOK_TOKEN=
HIKVISION_EXIT_WEBHOOK_TOKEN=
